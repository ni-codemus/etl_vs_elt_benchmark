aws_region   = "eu-west-3"
environment  = "dev"

# Reprend les valeurs de configs/.env pour garder le Terraform aligné avec l'application.
project_name                 = "bench-monitoring"
availability_zone            = null
vpc_cidr                     = "10.40.0.0/16"
public_subnet_cidr           = "10.40.0.0/24"
private_subnet_cidr          = "10.40.1.0/24"
private_subnet_secondary_cidr = "10.40.2.0/24"
db_engine_version            = "16.4"
db_instance_class            = "db.t3.micro"
db_allocated_storage         = 20
ec2_instance_type            = "t3.small"
ec2_root_volume_gb           = 30
app_root                     = "/opt/bench_monitoring"
git_repository_url           = "https://github.com/<owner>/<repo>.git"
git_repository_ref           = "main"

pg_dbname     = "bench_db"
pg_user       = "bench_user"
pg_password   = "change-me"
pg_super_user = "postgres"
pg_super_pass = "change-me-too"
